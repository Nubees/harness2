# Vertex AI & GCP Project configuration
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Model configurations (provider/model format for OpenCode)
HARNESS2_SOLVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_IMPROVER_MODEL=google-vertex/gemini-2.5-flash
HARNESS2_JUDGE_MODEL=gemini-2.5-flash

# Optional Codex substrate / bridge configurations
# HARNESS2_CODEX_MODEL=gemini-2.5-flash
# HARNESS2_CODEX_BASE_URL=http://localhost:4000
# HARNESS2_CODEX_API_KEY=

# Output directory (defaults to runs/)
# HARNESS2_RUNS_DIR=runs
